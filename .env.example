# Copy to .env (gitignored). Never commit real values.
MUBIT_BASE_URL=
MUBIT_API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compounding_minds
# Where fetchers save raw SEC and FRED files (gitignored). Loaders read from here, offline.
RAW_CACHE_DIR=data/raw
# Database tests run against this if reachable, and are skipped if not.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
SEC_USER_AGENT="Your Name your.email@example.com"
FRED_API_KEY=
# Banyan Sapling verifier (grader going-concern check). Blank = Mubit's Night Shift endpoint.
SAPLING_URL=
# 1 = agents read the hand-written store/stubs bundles instead of real metrics (agents/entry.py).
# Keep 1 until ingest has loaded real data, then set 0.
USE_STUBS=1
# 1 = FakeModelUpdater fallback if Mubit's update API is unavailable (label it in the UI)
USE_FAKE_UPDATER=0

# Optional: recent news in the research report (research/web.py). Without it the CLI's stored login is used, else no news.
FIRECRAWL_API_KEY=

# Optional hosted Postgres (Supabase session pooler). Copy the local data there with: python -m store.to_supabase
# Then set DATABASE_URL to this value to use it. Special characters in the password are encoded for you by that script.
SUPABASE_DB_URL=
