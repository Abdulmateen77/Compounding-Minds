# Copy to .env (gitignored). Never commit real values.
MUBIT_BASE_URL=
MUBIT_API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compounding_minds
# Where fetchers save raw SEC and FRED files (gitignored). Loaders read from here, offline.
RAW_CACHE_DIR=data/raw
# Database tests run against this if reachable, and are skipped if not.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
SEC_USER_AGENT="Your Name your.email@example.com"
FRED_API_KEY=
# Banyan Sapling verifier (grader going-concern check). Blank = Mubit's Night Shift endpoint.
SAPLING_URL=
# 1 = use store/stubs instead of the real store (Person B)
USE_STUBS=1
# 1 = FakeModelUpdater fallback if Mubit's update API is unavailable (label it in the UI)
USE_FAKE_UPDATER=0
